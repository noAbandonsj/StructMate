# Copy to .env at the repository root. No model key is needed for initialization.
CAPSTONE_ENVIRONMENT=development
# Relative paths are resolved from the repository root, regardless of shell cwd.
CAPSTONE_DATA_DIR=data
# JSON list. Vite normally accesses the backend through its /api proxy.
CAPSTONE_CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
