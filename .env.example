# Copy to .env at the repository root. No model key is needed for initialization.
CAPSTONE_ENVIRONMENT=development
# Relative paths are resolved from the repository root, regardless of shell cwd.
CAPSTONE_DATA_DIR=data
# JSON list. Vite normally accesses the backend through its /api proxy.
CAPSTONE_CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
# Account session lifetime. Production enables HTTPS-only cookies automatically.
CAPSTONE_SESSION_DAYS=7
# Document limits. No OCR for scanned PDFs in the first version.
CAPSTONE_UPLOAD_MAX_MIB=20
CAPSTONE_DOCUMENT_MAX_CHARS=500000
CAPSTONE_PDF_MAX_PAGES=300
CAPSTONE_CHUNK_CHARS=1200
# Retrieval threshold requires calibration with the actual embedding model.
CAPSTONE_RETRIEVAL_MIN_SCORE=0.25
# Optional backend-only model connection parameters. Blank means not configured.
# Providers and wire protocols are still pending confirmation; setting these values
# alone does NOT enable a model adapter or mark documents ready. No VITE_ secrets.
# Use an HTTP(S) address without userinfo or a fragment; keep keys in API_KEY.
CAPSTONE_GENERATION_BASE_URL=
CAPSTONE_GENERATION_MODEL=
CAPSTONE_GENERATION_API_KEY=
CAPSTONE_GENERATION_TIMEOUT_SECONDS=60
CAPSTONE_EMBEDDING_BASE_URL=
CAPSTONE_EMBEDDING_MODEL=
CAPSTONE_EMBEDDING_API_KEY=
CAPSTONE_EMBEDDING_TIMEOUT_SECONDS=60
# Optional expected output dimension, to be enforced by the future HTTP adapter.
# Existing persisted vectors are already checked against their actual batch dimension.
CAPSTONE_EMBEDDING_DIMENSION=
